# Remember tooling state (session logs, scratch, pids)
.remember/logs/
.remember/tmp/
**/.remember/logs/
**/.remember/tmp/

# OS / editor cruft
.DS_Store

# Sensitive personal records (SSN, DOB, medical/PHI) — never track in git
va-disability/personal-records/
va-disability/ClaudeDisabilityAssets/
va-disability/ClaudeChat/

# /rate-claim mock rating reports quote PHI-derived evidence — keep generated
# reports out of git; the directory's README is intentionally tracked.
va-disability/ratings/*.md
!va-disability/ratings/README.md
